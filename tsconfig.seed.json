
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/prisma",
    "rootDir": "./prisma",
    "module": "commonjs",
    "target": "ES2021",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["prisma/seed.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
